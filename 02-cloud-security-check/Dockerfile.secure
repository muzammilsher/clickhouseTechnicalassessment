# Use minimal official Python base
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Run as dedicated non-root system user
RUN groupadd --system --gid 10001 appgroup \
    && useradd --system --uid 10001 --gid 10001 --no-create-home appuser

# Dependencies layer cached separately
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application source with appropriate ownership
COPY --chown=10001:10001 . .

# Restrict permissions: 755 for directories, 644 for files
RUN find /app -type d -exec chmod 755 {} + \
    && find /app -type f -exec chmod 644 {} +

# Run container as non-root user
USER 10001:10001

EXPOSE 80

CMD ["python3", "app.py"]
